# ============================================================================
# NIO FAR — Variables d'environnement (copier vers .env)
# Ne commitez JAMAIS votre fichier .env contenant de vrais secrets.
# ============================================================================

# Serveur HTTP
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de données PostgreSQL (docker-compose.yml)
# En développement sans Docker, laissez PGLITE_FALLBACK=true pour utiliser PostgreSQL embarqué (PGlite)
DATABASE_URL=postgresql://niofar:niofar_dev_password@localhost:5432/niofar
PGLITE_FALLBACK=true
PGLITE_DATA_DIR=./.data/pgdata

# Authentification & Sécurité (remplacer par des secrets aléatoires >= 32 caractères en production)
JWT_SECRET=changez_moi_avec_une_cle_aleatoire_longue_32_caracteres_minimum
DEVICE_HASH_SALT=changez_moi_sel_hachage_anonyme_appareil_citoyen
COOKIE_SECURE=false

# Compte administrateur et relais de démonstration (utilisés uniquement par le script de seed)
SEED_ADMIN_EMAIL=admin@niofar.sn
SEED_ADMIN_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_ADMIN
SEED_RELAIS_EMAIL=relais@niofar.sn
SEED_RELAIS_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_RELAIS

# Transcription vocale (suggestions uniquement, jamais décisionnelles)
# Français : adaptateur Whisper compatible OpenAI / local
FR_ASR_PROVIDER=whisper
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# Wolof : modèle open source à évaluer — DÉSACTIVÉ PAR DÉFAUT tant qu'il n'a pas été validé
WOLOF_ASR_ENABLED=false
WOLOF_ASR_URL=
WOLOF_ASR_MODEL=

# Extraction de catégorie : mots-clés JSON d'abord, option LLM ensuite (jamais décisionnelle)
LLM_CATEGORY_ENABLED=false
LLM_API_URL=
LLM_API_KEY=

# Règle de conservation des données sensibles (en jours)
RETENTION_DAYS_CONTACT=90
RETENTION_DAYS_AUDIO=180
UPLOAD_DIR=./.data/uploads
